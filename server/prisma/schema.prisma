generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     Int       @id @default(autoincrement())
  name                   String
  email                  String    @unique
  password               String?
  provider               String    @default("manual")
  providerId             String?
  createdAt              DateTime  @default(now())
  passwordSetupExpiresAt DateTime?
  passwordSetupTokenHash String?
}
